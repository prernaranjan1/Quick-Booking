# Copy to .env and fill in. Never commit the real .env.
MONGODB_URI=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
TMDB_API_KEY=

# Razorpay (Dashboard > Settings > API Keys, use Test Mode keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Dashboard > Webhooks, URL <server>/api/booking/razorpay-webhook,
# events payment.captured and order.paid
RAZORPAY_WEBHOOK_SECRET=

# AI assistant (Google AI Studio)
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash
# THEATRE_TIMEZONE=Asia/Kolkata
